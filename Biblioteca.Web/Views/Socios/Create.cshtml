@model Socio
@{
    ViewData["Title"] = "Nuevo socio";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="page-header mb-3">
            <div>
                <h1><span class="title-icon"><i class="bi bi-person-plus"></i></span>Nuevo socio</h1>
                <p class="subtitle">Registra un nuevo miembro de la biblioteca</p>
            </div>
        </div>

        <div class="card-soft p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="DNI" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-vcard"></i></span>
                        <input asp-for="DNI" class="form-control" maxlength="8" placeholder="8 dígitos" />
                    </div>
                    <span asp-validation-for="DNI" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Nombre" class="form-control" />
                    </div>
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-brand"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}