@model Libro
@{
    ViewData["Title"] = "Nuevo libro";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="page-header mb-3">
            <div>
                <h1><span class="title-icon"><i class="bi bi-plus-circle"></i></span>Nuevo libro</h1>
                <p class="subtitle">Registra un libro en el catálogo</p>
            </div>
        </div>

        <div class="card-soft p-4">
            <form asp-action="Create" method="post">
                <partial name="_LibroForm" model="Model" />
                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-brand"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}