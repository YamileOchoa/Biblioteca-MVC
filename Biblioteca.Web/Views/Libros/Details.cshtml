@model Libro
@{
    ViewData["Title"] = "Detalle del libro";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-soft">
            <div class="detail-hero d-flex align-items-center gap-3">
                <div class="icon-big"><i class="bi bi-book-half"></i></div>
                <div>
                    <div class="small text-uppercase" style="opacity:.75; letter-spacing:1px;">Detalle del libro</div>
                    <h2 class="fw-bold m-0">@Model.Titulo</h2>
                </div>
            </div>

            <div class="detail-item">
                <div class="k">@Html.DisplayNameFor(m => m.ISBN)</div>
                <div class="v"><code>@Model.ISBN</code></div>
            </div>
            <div class="detail-item">
                <div class="k">@Html.DisplayNameFor(m => m.AutorNombre)</div>
                <div class="v"><i class="bi bi-person-fill me-1"></i>@Model.AutorNombre</div>
            </div>
            <div class="detail-item">
                <div class="k">@Html.DisplayNameFor(m => m.Ejemplares)</div>
                <div class="v">@Model.Ejemplares</div>
            </div>
            <div class="detail-item">
                <div class="k">Estado</div>
                <div class="v">
                    @if (Model.Activo)
                    {
                        <span class="badge rounded-pill text-bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill text-bg-secondary">Inactivo</span>
                    }
                </div>
            </div>

            <div class="p-3 d-flex gap-2 justify-content-end bg-body-tertiary">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
                <a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-brand"><i class="bi bi-pencil me-1"></i>Editar</a>
            </div>
        </div>
    </div>
</div>